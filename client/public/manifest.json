  "screenshots": [
    {
      "src": "/screenshots/desktop-dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard showing financial overview"
    },
    {
      "src": "/screenshots/mobile-transactions.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Transaction list on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Upload Statement",
      "short_name": "Upload",
      "description": "Upload a new bank statement",
      "url": "/?action=upload",
      "icons": [
        {
          "src": "/icons/shortcut-upload.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "View BAS",
      "short_name": "BAS",
      "description": "View BAS calculations",
      "url": "/?tab=bas",
      "icons": [
        {
          "src": "/icons/shortcut-bas.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Tax Summary",
      "short_name": "Tax",
      "description": "View tax summary",
      "url": "/?tab=tax",
      "icons": [
        {
          "src": "/icons/shortcut-tax.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", ".pdf", ".csv", ".ofx", ".qif"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+goldledger",
      "url": "/handle-protocol?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"],
        "text/csv": [".csv"],
        "application/x-ofx": [".ofx"],
        "application/x-qif": [".qif"]
      }
    }
  ]
}
