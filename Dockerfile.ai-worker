# =============================================================================
# Dockerfile for Python AI Workers - Optimized for Google Cloud Run Jobs
# =============================================================================
# Slim Python image for AI agent execution via Pydantic AI

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS deps

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY server/requirements.txt ./

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install dependencies with optimizations
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# -----------------------------------------------------------------------------
# Stage 2: Production Runtime
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    # For healthcheck
    curl \
    # CA certificates for HTTPS
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd -g 1001 python && \
    useradd -r -u 1001 -g python python

WORKDIR /app

# Copy virtual environment from deps stage
COPY --from=deps /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy agent code
COPY server/src/services/agents ./agents
COPY server/src/services/rag.py ./rag.py 2>/dev/null || true

# Copy any additional Python service files
COPY server/src/services/*.py ./services/ 2>/dev/null || true

# Set ownership to non-root user
RUN chown -R python:python /app

# Switch to non-root user
USER python

# Environment configuration
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Cloud Run Jobs port (not used for jobs, but included for flexibility)
ENV PORT=8080

# Entry point for Cloud Run Jobs
# Usage: docker run <image> <agent_type> <json_payload>
# Example: docker run <image> run financial_analyst '{"query": "...", "transactions": [...]}'
ENTRYPOINT ["python", "-m", "agents.runner"]

# Default command shows help
CMD ["info"]
