# ═══════════════════════════════════════════════════════════════════
# CBA Statements Parse — Environment Configuration
# Copy this file to .env and fill in the required values
# ═══════════════════════════════════════════════════════════════════

# ─── LLM Provider (OpenRouter) ────────────────────────────────────
# OpenRouter API key for LLM access (GPT-4o, Gemini, etc.)
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI API key (optional, used as fallback)
VITE_OPENAI_API_KEY=sk-your-key-here

# ─── Claude Agent Layer ───────────────────────────────────────────
# Anthropic API key for Claude-powered agents
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default Claude model for agent invocations
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Claude model for vision tasks (PDF parsing)
CLAUDE_VISION_MODEL=claude-sonnet-4-5-20250929

# ─── Feature Flags ───────────────────────────────────────────────
# Master switch: use Claude agents instead of OpenRouter
USE_CLAUDE_AGENTS=true

# Master switch: use Cognee knowledge graph instead of old RAG
USE_COGNEE=false

# Per-agent toggles (only apply when USE_CLAUDE_AGENTS=true)
AGENT_STATEMENT_PARSER=true
AGENT_TRANSACTION_CATEGORIZER=true
AGENT_GST_CALCULATOR=true
AGENT_ACCOUNT_RECONCILER=true
AGENT_BUDGET_ANALYZER=true
AGENT_CROSS_ACCOUNT_TRACER=true

# ─── Agent Tuning ────────────────────────────────────────────────
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_MS=60000
AGENT_MAX_TOOL_CALLS=10

# ─── PostgreSQL / Neon DB ─────────────────────────────────────────
# Local development defaults — override for production (Neon DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_accountant
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-in-production

# Full connection string (constructed from above, or override directly)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# SSL mode: 'disable' for local Docker, 'require' for Neon/production
PGSSLMODE=disable

# ─── Cognee Configuration ────────────────────────────────────────
# LLM settings for Cognee's knowledge graph extraction
LLM_PROVIDER=openai
LLM_MODEL=openrouter/openai/gpt-4o
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=16384

# Embedding settings (local fastembed — no API cost)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Vector store — PGVector (uses same PostgreSQL instance)
VECTOR_DB_PROVIDER=pgvector

# Graph store — Kuzu (embedded, file-based)
GRAPH_DATABASE_PROVIDER=kuzu

# Cognee API URL (Docker service name)
COGNEE_API_URL=http://cognee:8000

# Cognee security
REQUIRE_AUTHENTICATION=false
ENABLE_BACKEND_ACCESS_CONTROL=false
TELEMETRY_DISABLED=true
LOG_LEVEL=INFO

# Wave 3: Cognee admin credentials (used for multi-user admin operations)
COGNEE_ADMIN_EMAIL=admin@cognee-cba.dev
COGNEE_ADMIN_PASSWORD=CbaAdmin2026

# Wave 4: TFN encryption key — AES-256-GCM for TFN + bank account numbers at rest
# REQUIRED in production (server will refuse to start without it)
# Generate with: openssl rand -hex 32
TFN_ENCRYPTION_KEY=

# ─── External API Keys ──────────────────────────────────────────
# ABN Lookup GUID (register at https://abr.business.gov.au/Tools/WebServices)
ABNLOOKUP_GUID=

# Google API Key (for Places API merchant enrichment)
GOOGLE_API_KEY=

# ─── Application Server ──────────────────────────────────────────
# Hono server port
PORT=3501

# JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# ─── Push Notifications (VAPID) ──────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@goldledger.com.au

# ─── Client ──────────────────────────────────────────────────────
# API URL the React client connects to
VITE_API_URL=http://localhost:3501
