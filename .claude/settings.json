{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SPAWN_BACKEND": "tmux"
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"git commit\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/mnt/c/Users/Danie/Desktop/CBA Statements Parse/.claude/hooks/pre-commit-gate.sh'",
            "timeout": 30
          }
        ],
        "description": "Pre-commit quality gate — blocks @ts-ignore and @ts-expect-error in staged changes"
      },
      {
        "matcher": "tool == \"Write\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/mnt/c/Users/Danie/Desktop/CBA Statements Parse/.claude/hooks/block-dangerous-patterns.sh'",
            "timeout": 10
          }
        ],
        "description": "Block @ts-ignore, hardcoded secrets in new TypeScript files"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/mnt/c/Users/Danie/Desktop/CBA Statements Parse/.claude/hooks/post-edit-tsc.sh'",
            "timeout": 120
          }
        ],
        "description": "Run tsc after TypeScript file edits — shows error count"
      },
      {
        "matcher": "tool == \"Write\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/mnt/c/Users/Danie/Desktop/CBA Statements Parse/.claude/hooks/post-edit-tsc.sh'",
            "timeout": 120
          }
        ],
        "description": "Run tsc after new TypeScript files are created — shows error count"
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "sonatype-guide@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": true,
    "circleback@claude-plugins-official": true,
    "cognee-expert@cognee-expert": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "playground@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cognee-expert": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\Danie\\Desktop\\cognee-expert"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "tmux"
}
