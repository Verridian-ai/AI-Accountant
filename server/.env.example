# GoldLedger Server — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3501
NODE_ENV=development

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Admin Panel ──────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=change-me-to-a-different-long-random-string
ADMIN_DEFAULT_PASSWORD=change-me

# ─── Database: Local PostgreSQL (fallback when USE_NEON=false) ────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_accountant
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_STATEMENT_TIMEOUT=30000

# ─── Database: Neon Cloud (USE_NEON=true to activate) ────────────────────────
USE_NEON=false
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
NEON_AI_BRANCH_URL=postgresql://user:pass@ep-yyy.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id
NEON_ORG_ID=your-neon-org-id
NEON_BRANCH_ID=your-neon-production-branch-id
NEON_AI_BRANCH_ID=your-neon-ai-masked-branch-id
NEON_DB_NAME=neondb
NEON_DB_USER=your-neon-db-user
NEON_DB_PASSWORD=your-neon-db-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI: Anthropic / Claude ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6
USE_CLAUDE_AGENTS=true

# ─── AI: OpenRouter (fallback provider) ───────────────────────────────────────
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
# Legacy alias (some services use VITE_ prefix for SSR compat)
VITE_OPENROUTER_API_KEY=sk-or-your-openrouter-api-key

# ─── AI: Vercel AI SDK (optional) ─────────────────────────────────────────────
USE_VERCEL_SDK=false

# ─── Cognee (vector knowledge graph) ─────────────────────────────────────────
USE_COGNEE=false
COGNEE_API_URL=http://localhost:8000
COGWIT_API_KEY=your-cognee-api-key
COGNEE_ADMIN_EMAIL=admin@example.com
COGNEE_ADMIN_PASSWORD=change-me

# ─── Observability: Langfuse (optional tracing) ───────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── External APIs ────────────────────────────────────────────────────────────
# ABR (Australian Business Register) — ABN lookup
ABNLOOKUP_GUID=your-abn-lookup-guid

# Google Places — merchant enrichment
GOOGLE_API_KEY=your-google-api-key

# Cohere — reranking (optional)
COHERE_API_KEY=your-cohere-api-key

# ─── Email ────────────────────────────────────────────────────────────────────
# Resend (https://resend.com) — transactional email
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# ─── Payments: Stripe (optional) ─────────────────────────────────────────────
APP_URL=http://localhost:5173

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (production)
ALLOWED_ORIGINS=https://yourdomain.com

# ─── Encryption ───────────────────────────────────────────────────────────────
# 64-char hex string (32 bytes) for TFN field-level encryption
TFN_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ─── Payroll ──────────────────────────────────────────────────────────────────
# Superannuation guarantee rate (e.g. 0.12 for 12%)
SUPER_GUARANTEE_RATE=0.12

# ─── Testing ──────────────────────────────────────────────────────────────────
TEST_BASE_URL=http://localhost:3501
