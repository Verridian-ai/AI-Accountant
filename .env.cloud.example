# =============================================================================
# Environment Variables for Cloud Run Local Development
# =============================================================================
# Copy this file to .env.cloud and fill in your values
# Usage: docker-compose -f docker-compose.cloud.yml --env-file .env.cloud up

# -----------------------------------------------------------------------------
# Google Cloud Configuration
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Cloud SQL connection name (format: project:region:instance)
CLOUD_SQL_CONNECTION_NAME=your-project-id:australia-southeast1:ai-accountant-db

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_NAME=ai_accountant
DB_PASSWORD=your-secure-password

# Full database URL (used by Drizzle ORM)
# For Cloud SQL Proxy: postgresql://postgres:PASSWORD@cloudsql-proxy:5432/ai_accountant
# For direct connection: postgresql://postgres:PASSWORD@/ai_accountant?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@cloudsql-proxy:5432/${DB_NAME}

# -----------------------------------------------------------------------------
# AI/LLM API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-min-32-chars

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_RAG=true
ENABLE_AGENTS=true
